{
  "name": "sprout-learning",
  "version": "1.0.0",
  "description": "A little learning, a lot of growth. Learn JavaScript and React at your own pace.",
  "scripts": {
    "dev": "node scripts/build-preview.mjs && vite",
    "build": "node scripts/build-preview.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/learning.test.mjs tests/security.test.mjs",
    "format": "prettier --write src scripts tests docs README.md *.json *.ts *.js .github/workflows/*.yml",
    "predev": "node scripts/build-catalog.mjs",
    "prebuild": "node scripts/build-catalog.mjs",
    "pretest": "node scripts/build-test-runtime.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests docs README.md *.json *.ts *.js .github/workflows/*.yml",
    "test:browser": "playwright test",
    "test:serve": "node scripts/build-browser-tests.mjs && vite preview --host 127.0.0.1 --port 4173 --outDir output/browser-app",
    "lint": "eslint . --max-warnings 0",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run test:unit && npm run build && npm run check:budgets",
    "pretypecheck": "node scripts/build-catalog.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/standalone": "^8.0.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-reconciler": "0.34.0",
    "zod": "^4.6.7",
    "quickjs-emscripten-core": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
